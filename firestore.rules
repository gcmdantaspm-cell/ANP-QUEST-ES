rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email.lower() == 'gcm.dantas.pm@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidQuestion(data) {
      return data.modulo is string &&
             data.capitulo is string &&
             data.enunciado is string &&
             data.alternativas is list;
    }

    function isValidComment(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.texto is string &&
             data.texto.size() > 0 &&
             data.texto.size() <= 5000;
    }

    match /questions/{questionId} {
      // Qualquer pessoa autenticada ou visitante pode ler as questões
      allow get, list: if true;
      // Apenas o administrador pode criar, editar ou excluir questões
      allow create, update: if isValidId(questionId) && isAdmin() && isValidQuestion(request.resource.data);
      allow delete: if isValidId(questionId) && isAdmin();

      match /comments/{commentId} {
        allow get, list: if true;
        allow create: if isValidId(commentId) && isSignedIn() && isValidComment(request.resource.data);
        allow update: if isValidId(commentId) && isSignedIn() &&
                      isValidComment(request.resource.data) &&
                      (resource.data.userId == request.auth.uid || isAdmin());
        allow delete: if isValidId(commentId) && isSignedIn() &&
                      (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Matrículas autorizadas a realizar login e acessar a plataforma
    match /authorized_matriculas/{matriculaId} {
      // O Administrador tem acesso total
      allow read, write: if isAdmin();

      // Qualquer usuário autenticado com Google pode consultar para validação de matrícula
      allow get: if isSignedIn();

      // Aluno autenticado pode vincular sua conta Google à matrícula livre
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.active == true &&
          (resource.data.linkedUid == null || resource.data.linkedUid == request.auth.uid) &&
          request.resource.data.linkedUid == request.auth.uid &&
          request.resource.data.linkedEmail == request.auth.token.email
        )
      );
    }

    // Coleção de usuários e perfis com matrícula vinculada
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
